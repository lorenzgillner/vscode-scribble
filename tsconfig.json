{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmitOnError": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["assets", "node_modules", "out"]
}
